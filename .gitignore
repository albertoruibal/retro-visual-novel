# Build outputs (regenerated by the editor server / tools/build.py).
# Intermediates, generated sources and bank images live in <game>/build/;
# only the playable artifacts stay at the game root. The repo ships one game,
# demo-game/.
/demo-game/build/
/demo-game/web/
/demo-game/*.tap
/demo-game/*.sna
/demo-game/*.nex
/demo-game/*.sms
/demo-game/*.dsk
/demo-game/*.rom
/demo-game/*.gb
/demo-game/*.gbc
/demo-game/*.prg
/demo-game/*.nes
/demo-game/*.cdt
/demo-game/*.cpc
/demo-game/*_CODE.bin
/demo-game/*_BSS.bin
/demo-game/*_DATA.bin
/demo-game/game.md.bak
/demo-game/game-*.md.bak
/NIRVANAP_ENGINE.asm
vendor/nirvanap/NIRVANAP_ENGINE.asm
vendor/nirvanap/nirvanap.lib

# Generated image/song previews and model result JSONs. Art and reference
# candidates live under assets/art/<id>/ and assets/refs/<id>/ (kept); their
# prompts live in game.md, so only the raw JSONs beside them are ignored.
/demo-game/assets/gen/
/demo-game/assets/art/*/*.json
/demo-game/assets/refs/*/*.json

# Editor runtime state
tools/editor/.state.json
tools/editor/.settings.json
docs/game.md.bak

# Test-harness captures / scratch output
tools/out/
tools/__pycache__/
__pycache__/
*.pyc

# Emulator (vendored by symlink; see AGENTS.md)
ZEsarUX-13.0
zesarux_index_menu.idx
*.idx

# Local compose overrides (host model URLs etc.)
.env
compose.override.yml
docker-compose.override.yml

# Local model weights (large; fetched by models/download-*.sh)
models/*.gguf
models/*.safetensors

# OS / editor junk
.idea/

# Electron desktop shell
electron/node_modules/
electron/dist/
electron/dist-resources/

# Local Python env for the editor/build tooling (see prepare-python.js)
.venv/

# A z88dk toolchain dropped in the repo root (never committed; point the
# editor's Settings -> Build toolchain card at it instead)
/z88dk/
